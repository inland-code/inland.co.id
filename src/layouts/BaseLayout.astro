---
import '@/styles/global.css';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFab from '@/components/WhatsAppFab.astro';
import { localeMeta, type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { isProduction } from '@/lib/env';
import { absoluteUrl, graph, organizationSchema, websiteSchema } from '@/lib/seo';
import site from '@/data/site.json';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path kanonik halaman ini, contoh "/tentang-inland/". */
  path: string;
  alternates: { locale: Locale; path: string }[];
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { locale, title, description, path, alternates, ogImage, ogType = 'website', noindex = false, jsonLd = [], publishedTime, modifiedTime } =
  Astro.props;

const canonical = absoluteUrl(path);
const robots = !isProduction || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const og = ogImage ? await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 }) : undefined;
const idAlt = alternates.find((a) => a.locale === 'id');
const structured = graph(organizationSchema(), websiteSchema(locale), ...jsonLd);
---
<!doctype html>
<html lang={localeMeta[locale].htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={absoluteUrl(a.path)} />)}
    {idAlt && alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={absoluteUrl(idAlt.path)} />}

    <Font cssVariable="--font-roboto" preload />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f2821f" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    {alternates.filter((a) => a.locale !== locale).map((a) => <meta property="og:locale:alternate" content={localeMeta[a.locale].ogLocale} />)}
    {og && <meta property="og:image" content={absoluteUrl(og.src)} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="text/plain" title="LLMs" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap_index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />

    <!-- Prefetch/prerender halaman internal saat hover (Speculation Rules, tanpa JS tambahan). -->
    <script type="speculationrules" set:html={JSON.stringify({
      prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/admin/*' } }] }, eagerness: 'moderate' }],
    })} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only z-50 rounded bg-espresso-900 px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2">
      {t(locale, 'nav.skip')}
    </a>
    <Header locale={locale} alternates={alternates} currentPath={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppFab locale={locale} />
  </body>
</html>
