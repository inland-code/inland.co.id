---
/** Tampilan artikel (konten dari src/content/posts). */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PostCard from '@/components/PostCard.astro';
import { alternatesFor, getRoutes, hrefFor, type Route } from '@/lib/routes';
import { imageFor } from '@/lib/media';
import { ogPath } from '@/lib/og';
import { absoluteUrl, breadcrumbSchema, faqSchema, ORG_ID } from '@/lib/seo';
import { t } from '@/i18n/ui';

type PostRoute = Extract<Route, { kind: 'post' }>;
interface Props {
  route: PostRoute;
}
const { route } = Astro.props;
const { locale } = route;
const data = route.entry.data;

const alternates = await alternatesFor(route.translationKey);
const crumbs = [
  { name: t(locale, 'breadcrumb.home'), path: await hrefFor('home', locale) },
  { name: t(locale, 'nav.articles'), path: await hrefFor('articles', locale) },
  { name: data.title, path: route.path },
];
const { Content, headings } = await render(route.entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.filter((h) => h.depth === 2).length >= 3;
// Artikel terkait: kategori sama lebih dulu, lalu artikel terbaru lain (bahasa sama).
const related = (await getRoutes())
  .filter((r): r is PostRoute => r.kind === 'post' && r.locale === locale && r.path !== route.path)
  .sort(
    (a, b) =>
      Number(b.entry.data.category === data.category) - Number(a.entry.data.category === data.category) ||
      b.entry.data.publishedAt.getTime() - a.entry.data.publishedAt.getTime(),
  )
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-US', { dateStyle: 'long' });

const jsonLd: object[] = [
  {
    '@type': 'BlogPosting',
    '@id': `${absoluteUrl(route.path)}#article`,
    headline: data.title,
    description: data.seo.description,
    url: absoluteUrl(route.path),
    mainEntityOfPage: absoluteUrl(route.path),
    image: absoluteUrl(ogPath(route.path)),
    inLanguage: locale === 'id' ? 'id-ID' : 'en',
    datePublished: data.publishedAt.toISOString(),
    dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
    author: { '@type': 'Organization', name: data.author, url: absoluteUrl('/') },
    publisher: { '@id': ORG_ID },
  },
  breadcrumbSchema(crumbs),
  ...(data.faq.length ? [faqSchema(data.faq)] : []),
];
---

<BaseLayout
  locale={locale}
  title={data.seo.title}
  description={data.seo.description}
  path={route.path}
  alternates={alternates}
  ogImageUrl={ogPath(route.path)}
  ogType="article"
  noindex={data.seo.noindex}
  publishedTime={data.publishedAt}
  modifiedTime={data.updatedAt}
  jsonLd={jsonLd}
>
  <article class="pb-20">
    <header class="bg-brand-gradient">
      <div class="container-site grid items-center gap-10 py-12 lg:grid-cols-2 lg:py-16">
        <div>
          <div class="[&_*]:text-white/80 [&_a:hover]:text-white">
            <Breadcrumbs items={crumbs} />
          </div>
          <h1 class="mt-5 text-3xl font-bold tracking-tight text-balance text-white sm:text-4xl">{data.title}</h1>
          <p class="mt-4 text-white/90">{data.excerpt}</p>
          <p class="mt-5 text-sm text-white/80">
            {t(locale, 'post.publishedOn')} <time datetime={data.publishedAt.toISOString()}>{fmt.format(data.publishedAt)}</time> ·{' '}
            {data.author}
          </p>
        </div>
        <Image
          src={imageFor(data.image)}
          alt={data.imageAlt}
          priority
          width={720}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="aspect-[4/3] w-full rounded-card object-cover shadow-card"
        />
      </div>
    </header>
    <div class="container-site mt-12 max-w-3xl">
      {showToc && (
        <details open class="mb-8 rounded-card bg-surface-alt p-5 ring-1 ring-brand-100">
          <summary class="cursor-pointer font-semibold text-heading">{t(locale, 'post.toc')}</summary>
          <ol class="mt-3 space-y-1.5">
            {toc.map((h) => (
              <li class:list={[h.depth === 3 && 'ml-5 text-sm']}>
                <a href={`#${h.slug}`} class="text-muted hover:text-accent-strong">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
      <div class="space-y-5 text-lg leading-relaxed text-ink [&_a]:text-accent-strong [&_a]:underline [&_blockquote]:border-l-4 [&_blockquote]:border-brand-500 [&_blockquote]:bg-surface-alt [&_blockquote]:px-5 [&_blockquote]:py-3 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-heading [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-heading [&_li]:mt-1.5 [&_ol]:list-decimal [&_ol]:pl-6 [&_table]:block [&_table]:w-full [&_table]:overflow-x-auto [&_table]:rounded-xl [&_table]:text-base [&_table]:ring-1 [&_table]:ring-line [&_td]:border-t [&_td]:border-line [&_td]:px-4 [&_td]:py-3 [&_th]:bg-brand-50 [&_th]:px-4 [&_th]:py-3 [&_th]:text-left [&_th]:text-heading [&_ul]:list-disc [&_ul]:pl-6">
        <Content />
      </div>
    </div>
    {related.length > 0 && (
      <section class="container-site mt-20" aria-labelledby="related-heading">
        <h2 id="related-heading" class="text-2xl font-bold text-heading">
          {t(locale, 'post.related')}
        </h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <PostCard
              locale={locale}
              href={p.path}
              title={p.entry.data.title}
              excerpt={p.entry.data.excerpt}
              image={p.entry.data.image}
              imageAlt={p.entry.data.imageAlt}
              category={p.entry.data.category}
              date={p.entry.data.publishedAt}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
