---
/** Tampilan halaman (konten dari src/content/pages). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PostCard from '@/components/PostCard.astro';
import Sections from '@/components/sections/Sections.astro';
import { alternatesFor, getRoutes, hrefFor, type Route } from '@/lib/routes';
import { ogPath } from '@/lib/og';
import { absoluteUrl, breadcrumbSchema, faqSchema, ORG_ID, serviceSchema } from '@/lib/seo';
import { t } from '@/i18n/ui';

type PageRoute = Extract<Route, { kind: 'page' }>;
interface Props {
  route: PageRoute;
}
const { route } = Astro.props;
const { locale } = route;
const data = route.entry.data;

const alternates = await alternatesFor(route.translationKey);
const homePath = await hrefFor('home', locale);

// Template "articles": daftar artikel bahasa aktif (fallback ID bila belum ada terjemahan).
let posts: Extract<Route, { kind: 'post' }>[] = [];
if (data.template === 'articles') {
  const all = await getRoutes();
  const pick = (l: typeof locale) =>
    all
      .filter((r): r is Extract<Route, { kind: 'post' }> => r.kind === 'post' && r.locale === l)
      .sort((a, b) => b.entry.data.publishedAt.getTime() - a.entry.data.publishedAt.getTime());
  posts = pick(locale).length ? pick(locale) : pick('id');
}

const faqs = data.sections.flatMap((s) => (s.type === 'faq' ? s.items : []));
const jsonLd: object[] = [
  {
    '@type': data.template === 'contact' ? 'ContactPage' : data.template === 'about' ? 'AboutPage' : 'WebPage',
    '@id': `${absoluteUrl(route.path)}#webpage`,
    url: absoluteUrl(route.path),
    name: data.seo.title,
    description: data.seo.description,
    inLanguage: locale === 'id' ? 'id-ID' : 'en',
    isPartOf: { '@id': `${absoluteUrl('/')}#website` },
    about: { '@id': ORG_ID },
  },
  ...(route.slug
    ? [
        breadcrumbSchema([
          { name: t(locale, 'breadcrumb.home'), path: homePath },
          { name: data.hero.title, path: route.path },
        ]),
      ]
    : []),
  ...(faqs.length ? [faqSchema(faqs)] : []),
  ...(data.template === 'service'
    ? [serviceSchema({ name: data.hero.title, description: data.seo.description, path: route.path, locale })]
    : []),
];
---

<BaseLayout
  locale={locale}
  title={data.seo.title}
  description={data.seo.description}
  path={route.path}
  alternates={alternates}
  ogImageUrl={ogPath(route.path)}
  noindex={data.seo.noindex}
  jsonLd={jsonLd}
>
  <PageHero locale={locale} {...data.hero} />
  {data.template === 'articles' ? (
    <section class="container-site py-16">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <PostCard
            locale={locale}
            href={p.path}
            title={p.entry.data.title}
            excerpt={p.entry.data.excerpt}
            image={p.entry.data.image}
            imageAlt={p.entry.data.imageAlt}
            category={p.entry.data.category}
            date={p.entry.data.publishedAt}
            headingLevel={2}
          />
        ))}
      </div>
    </section>
  ) : (
    <Sections sections={data.sections} locale={locale} />
  )}
</BaseLayout>
