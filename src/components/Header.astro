---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { mainNav, type NavItem } from '@/data/navigation';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { hrefFor } from '@/lib/routes';

interface Props {
  locale: Locale;
  currentPath: string;
  alternates: { locale: Locale; path: string }[];
}
const { locale, currentPath, alternates } = Astro.props;

const label = (l: NavItem['label']) => (typeof l === 'string' ? t(locale, l) : l[locale]);

const nav = await Promise.all(
  mainNav.map(async (item) => ({
    label: label(item.label),
    href: await hrefFor(item.key, locale),
    groups: item.children
      ? await Promise.all(
          item.children.map(async (g) => ({
            label: g.group[locale],
            href: await hrefFor(g.groupKey, locale),
            items: await Promise.all(g.items.map(async (it) => ({ label: it.label[locale], href: await hrefFor(it.key, locale) }))),
          })),
        )
      : undefined,
  })),
);
const homeHref = await hrefFor('home', locale);
const isActive = (href: string, groups?: { href: string; items: { href: string }[] }[]) =>
  currentPath === href || !!groups?.some((g) => g.href === currentPath || g.items.some((i) => i.href === currentPath));
---
<header class="sticky top-0 z-40 border-b border-black/5 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/75">
  <div class="container-site flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href={homeHref} class="shrink-0" aria-label="Inland — Beranda">
      <Logo class="h-10 w-auto lg:h-12" height={48} priority />
    </a>

    <!-- Navigasi desktop: dropdown murni CSS (hover + focus-within), tanpa JavaScript. -->
    <nav aria-label="Menu utama" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li class="group relative">
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class:list={[
                'inline-flex items-center gap-1 rounded-md px-3 py-2 text-[0.95rem] font-medium transition hover:text-brand-700',
                isActive(item.href, item.groups) ? 'text-brand-700' : 'text-ink',
              ]}
            >
              {item.label}
              {item.groups && (
                <svg class="size-4 transition group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.2 7.2a.75.75 0 0 1 1.06 0L10 10.94l3.74-3.74a.75.75 0 1 1 1.06 1.06l-4.27 4.27a.75.75 0 0 1-1.06 0L5.2 8.26a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              )}
            </a>
            {item.groups && (
              <div class="invisible absolute left-1/2 top-full w-[42rem] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <div class="grid grid-cols-3 gap-2 rounded-2xl border border-black/5 bg-white p-4 shadow-card">
                  {item.groups.map((g) => (
                    <div>
                      <a href={g.href} class="block rounded-lg px-3 py-2 text-sm font-semibold text-espresso-900 hover:bg-brand-50">{g.label}</a>
                      <ul>
                        {g.items.map((it) => (
                          <li>
                            <a href={it.href} class="block rounded-lg px-3 py-1.5 text-sm text-muted hover:bg-brand-50 hover:text-brand-700">{it.label}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} alternates={alternates} />
      <!-- Menu mobile memakai Popover API bawaan browser (tanpa JavaScript). -->
      <button
        type="button"
        popovertarget="mobile-menu"
        class="inline-flex size-11 items-center justify-center rounded-lg text-ink hover:bg-brand-50 lg:hidden"
        aria-label={t(locale, 'nav.menu')}
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" popover class="m-0 ml-auto h-dvh max-h-none w-[min(22rem,100%)] overflow-y-auto bg-white p-6 shadow-2xl backdrop:bg-black/40">
    <div class="mb-6 flex items-center justify-between">
      <Logo class="h-10 w-auto" height={40} />
      <button type="button" popovertarget="mobile-menu" popovertargetaction="hide" class="inline-flex size-11 items-center justify-center rounded-lg hover:bg-brand-50" aria-label={t(locale, 'nav.close')}>
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" /></svg>
      </button>
    </div>
    <nav aria-label="Menu mobile">
      <ul class="space-y-1">
        {nav.map((item) => (
          <li>
            {item.groups ? (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 font-medium hover:bg-brand-50">
                  {item.label}
                  <svg class="size-5 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.2 7.2a.75.75 0 0 1 1.06 0L10 10.94l3.74-3.74a.75.75 0 1 1 1.06 1.06l-4.27 4.27a.75.75 0 0 1-1.06 0L5.2 8.26a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
                </summary>
                <div class="ml-3 border-l border-brand-100 pl-3">
                  <a href={item.href} class="block rounded-lg px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50">{item.label}</a>
                  {item.groups.map((g) => (
                    <div class="mt-1">
                      <a href={g.href} class="block rounded-lg px-3 py-2 text-sm font-semibold text-espresso-900 hover:bg-brand-50">{g.label}</a>
                      {g.items.map((it) => (
                        <a href={it.href} class="block rounded-lg px-3 py-2 text-sm text-muted hover:bg-brand-50">{it.label}</a>
                      ))}
                    </div>
                  ))}
                </div>
              </details>
            ) : (
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined} class="block rounded-lg px-3 py-3 font-medium hover:bg-brand-50 aria-[current=page]:text-brand-700">
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
