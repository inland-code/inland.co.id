---
import { Image } from 'astro:assets';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import type { Locale } from '@/i18n/config';
import { imageFor } from '@/lib/media';
import { resolveHref } from '@/lib/links';

interface Props {
  locale: Locale;
  title: string;
  tagline?: string;
  body: string;
  image: string;
  imageAlt: string;
  ctas?: { label: string; href: string; variant: 'light' | 'dark' | 'whatsapp' | 'outline' }[];
}
const { locale, title, tagline, body, image, imageAlt, ctas = [] } = Astro.props;
const resolved = await Promise.all(
  ctas.map(async (c) => ({ ...c, url: await resolveHref(c.href, locale), external: c.href === '#whatsapp' })),
);
const cls = { light: 'btn-light', dark: 'btn-dark', whatsapp: 'btn-dark', outline: 'btn-outline' } as const;
---
<section class="relative grid overflow-hidden bg-brand-gradient lg:min-h-[min(85vh,52rem)] lg:grid-cols-12">
  <div class="relative aspect-[4/3] sm:aspect-[16/9] lg:col-span-5 lg:aspect-auto">
    <!-- Gambar LCP: priority = loading eager + fetchpriority high. -->
    <Image
      src={imageFor(image)}
      alt={imageAlt}
      priority
      layout="full-width"
      sizes="(min-width: 1024px) 42vw, 100vw"
      class="absolute inset-0 size-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-black/10" aria-hidden="true"></div>
  </div>
  <div class="flex items-center lg:col-span-7">
    <div class="w-full px-5 py-12 sm:px-10 lg:px-14 lg:py-20 xl:px-20">
      <h1 class="text-3xl font-bold tracking-tight text-balance text-white sm:text-4xl xl:text-5xl">{title}</h1>
      {tagline && <p class="mt-4 text-lg font-semibold text-white/95 italic">{tagline}</p>}
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-pretty text-white/90 sm:text-lg">{body}</p>
      {resolved.length > 0 && (
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {resolved.map((c) => (
            <a href={c.url} class:list={[cls[c.variant], 'sm:min-w-52']} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {c.external && <WhatsAppIcon />}
              {c.label}
              {!c.external && <span aria-hidden="true">→</span>}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
