---
import { Picture } from 'astro:assets';
import Icon from '@/components/icons/Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@/content.config';
import type { Locale } from '@/i18n/config';
import { imageFor } from '@/lib/media';
import { resolveHref } from '@/lib/links';
type Props = Extract<Section, { type: 'accordion-media' }> & { locale: Locale; index: number };
const { eyebrow, title, intro, tone, imageSide, image, imageAlt, numbered, items, cta, locale, index } = Astro.props;
const ctaUrl = cta ? await resolveHref(cta.href, locale) : undefined;
const brand = tone === 'brand';
const group = `acc-${index}`;
---
<section class:list={['grid lg:grid-cols-12', brand ? 'bg-brand-gradient' : 'bg-surface-alt']}>
  <div class:list={['flex items-center lg:col-span-7', imageSide === 'left' && 'lg:order-2']}>
    <div class="w-full px-5 py-16 sm:px-10 lg:px-14 lg:py-24 xl:px-20">
      <SectionHeading eyebrow={eyebrow} title={title} intro={intro} align="left" tone={brand ? 'light' : 'dark'} />
      <div class="mt-8 space-y-3">
        {/* Akordeon eksklusif bawaan HTML (atribut name), tanpa JavaScript. */}
        {items.map((it, i) => (
          <details name={group} open={i === 0} class:list={['group rounded-xl transition', brand ? 'bg-white/10 ring-1 ring-white/25 open:bg-white/15' : 'bg-white ring-1 ring-black/5 open:shadow-card']}>
            <summary class:list={['flex cursor-pointer list-none items-center gap-4 px-5 py-4 font-semibold', brand ? 'text-white' : 'text-espresso-900']}>
              {numbered && <span class:list={['inline-flex size-8 shrink-0 items-center justify-center rounded-full text-sm', brand ? 'bg-white text-brand-800' : 'bg-brand-500 text-white']}>{i + 1}</span>}
              <span class="flex-1">{it.title}</span>
              <Icon name="plus" class="size-5 shrink-0 transition group-open:rotate-45" />
            </summary>
            <p class:list={['px-5 pb-5 leading-relaxed', numbered && 'pl-17', brand ? 'text-white/90' : 'text-muted']}>{it.text}</p>
          </details>
        ))}
      </div>
      {cta && ctaUrl && (
        <a href={ctaUrl} class:list={['mt-8', brand ? 'btn-light' : 'btn-dark']}>
          {cta.label} <Icon name="arrow" class="size-4" />
        </a>
      )}
    </div>
  </div>
  <div class:list={['relative min-h-80 lg:col-span-5', imageSide === 'left' && 'lg:order-1']}>
    <Picture formats={["avif", "webp"]} src={imageFor(image)} alt={imageAlt} width={900} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 size-full object-cover" />
  </div>
</section>
