---
import Icon from '@/components/icons/Icon.astro';
import type { Section } from '@/content.config';
import type { Locale } from '@/i18n/config';
import { resolveHref } from '@/lib/links';
type Props = Extract<Section, { type: 'service-detail' }> & { locale: Locale };
const { title, text, bars, cards, locale } = Astro.props;
const resolved = await Promise.all(cards.map(async (c) => ({ ...c, url: c.cta ? await resolveHref(c.cta.href, locale) : undefined })));
---
<section class="border-b border-brand-100 py-16 last-of-type:border-0 sm:py-20">
  <div class="container-site grid gap-10 lg:grid-cols-2 lg:gap-14">
    <div>
      <h2 class="text-3xl font-bold tracking-tight text-espresso-900">{title}</h2>
      <p class="mt-5 leading-relaxed text-muted">{text}</p>
      {bars.length > 0 && (
        <ul class="mt-8 space-y-4">
          {bars.map((b) => (
            <li>
              <div class="flex justify-between text-sm font-medium text-ink"><span>{b.label}</span><span class="text-brand-700">{b.value}%</span></div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-brand-100" role="presentation">
                <div class="h-full rounded-full bg-gradient-to-r from-brand-400 to-brand-700" style={`width:${b.value}%`}></div>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="space-y-5">
      {resolved.map((c) => (
        <article class="relative overflow-hidden rounded-card bg-brand-gradient p-7 text-white shadow-card">
          <h3 class="text-2xl font-bold">{c.title}</h3>
          <p class="mt-3 leading-relaxed text-white/90">{c.text}</p>
          {c.cta && c.url && <a href={c.url} class="btn-light mt-6">{c.cta.label} <Icon name="arrow" class="size-4" /></a>}
        </article>
      ))}
    </div>
  </div>
</section>
