# URL warisan WordPress -> padanan baru (301 permanen, menjaga SEO).
/feed/              /feed.xml          301
/feed               /feed.xml          301
/comments/feed/     /artikel/          301
/category/*         /artikel/          301
/tag/*              /artikel/          301
/author/*           /tentang-inland/   301
/page/*             /artikel/          301
/wp-admin/*         /                  301
/wp-login.php       /                  301
/xmlrpc.php         /                  301
/sitemap.xml        /sitemap_index.xml 301
/wp-sitemap.xml     /sitemap_index.xml 301

# File media WordPress lama (terindeks di Google Gambar) -> galeri.
/wp-content/*       /galeri-inland/    301
/wp-includes/*      /                  301
# Sitemap Rank Math lain yang tidak lagi dipakai.
/category-sitemap.xml  /sitemap_index.xml 301
/local-sitemap.xml     /sitemap_index.xml 301
/author-sitemap.xml    /sitemap_index.xml 301
